DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecila
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-3.8-flash
SYNTHESIS_PROVIDER=openai
AI_REQUEST_TIMEOUT_MS=60000
SESSION_SECRET=replace-with-a-long-random-secret
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
TASK_PROCESSING_MODE=inline
MAX_PROMPT_CHARS=30000
RESEARCH_TIMEOUT_MS=15000

MAX_UPLOAD_BYTES=26214400
LOCAL_STORAGE_PATH=./storage/uploads

# Optional production object storage (use instead of local disk)
STORAGE_REGION=

# Document worker
DOCUMENT_WORKER_INTERVAL_MS=1500
DOCUMENT_AI_PROVIDER=openai
DOCUMENT_AI_MODEL=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_VISION_MODEL=gpt-5-mini

# Production workers
WORKER_DB_POOL_SIZE=5
TASK_MAX_ATTEMPTS=3

# Public application URL and transactional email (password recovery)
APP_URL=http://localhost:3000
RESEND_API_KEY=
EMAIL_FROM=ECILA <noreply@example.com>

# S3-compatible object storage (required in production)
STORAGE_FORCE_PATH_STYLE=true


SERPER_API_KEY=
TASK_STALE_MINUTES=15
